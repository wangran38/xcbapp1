
	/* 城市标题栏：区分层级 */
.city-title.data-v-7170c164 {
		padding: 24rpx 30rpx;
		font-size: 32rpx;
		font-weight: 600;
		color: #333;
		border-bottom: 1rpx solid #f5f5f5;
}

	/* 区县列表项：优化间距和交互 */
.district-item.data-v-7170c164 {
		padding: 28rpx 30rpx;
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1rpx solid #f8f8f8;
		transition: background-color 0.2s;
}

	/* 最后一项去掉下边框 */
.district-item.data-v-7170c164:last-child {
		border-bottom: none;
}

	/* 点击态：增加交互反馈 */
.district-item.data-v-7170c164:active {
		background-color: #fafafa;
}

	/* 区县信息区域：支持扩展其他数据 */
.district-info.data-v-7170c164 {
		display: flex;
		flex-direction: column;
		gap: 4rpx;
}

	/* 区县名称：主信息突出 */
.district-name.data-v-7170c164 {
		font-size: 35rpx;
		color: #333;
}
.district-extra.data-v-7170c164 {
		font-size: 30rpx;
		color: #999;
}
.agent-index-page.data-v-7170c164 {
		background-color: #f8f9fa;
		min-height: 100vh;
		font-size: 14px;
		padding-bottom: 40px;
}
.page-header.data-v-7170c164 {
		padding: 20px 16px;
		background-color: #fff;
		border-bottom: 1px solid #f5f5f5;
}
.header-title.data-v-7170c164 {
		font-size: 20px;
		font-weight: 600;
		color: #2d3748;
		margin-bottom: 10px;
}
.level-switch.data-v-7170c164 {
		position: absolute;
		top: 20px;
		right: 20px;
		font-size: 12px;
		color: #FF9500;
		padding: 4px 8px;
		border: 1px solid #4285F4;
		border-radius: 4px;
}
.role-tag.data-v-7170c164 {
		display: inline-block;
		padding: 4px 16px;
		border-radius: 20px;
		font-size: 12px;
		margin-bottom: 15px;
}
.provincial.data-v-7170c164 {
		background-color: #e8f4fd;
		color: #4285F4;
}
.municipal.data-v-7170c164 {
		background-color: #e6f4ea;
		color: #34A853;
}

	/* 清除页面默认留白，保证卡片全屏 */
page.data-v-7170c164 {
		padding: 0;
		margin: 0;
		background-color: #fafafa;
}

	/* 核心卡片容器 */
.summary-card.data-v-7170c164 {
		background-color: #ffffff;
		border-radius: 12rpx;
		box-shadow: 0 4rpx 20rpx rgba(255, 125, 0, 0.08);
		padding: 30rpx 20rpx;
		margin: 20rpx 0 0;
		width: 100%;
		box-sizing: border-box;
		border: 1rpx solid #FFE8D0;
}

	/* 收益总额单独突出区 - 视觉核心 */
.summary-highlight.data-v-7170c164 {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 25rpx 0;
		margin-bottom: 25rpx;
		/* 渐变背景突出收益 */
		background: linear-gradient(135deg, #FFF8F0 0%, #FFFAF5 100%);
		border-radius: 10rpx;
		position: relative;
}

	/* 收益标签 */
.highlight-label.data-v-7170c164 {
		font-size: 28rpx;
		color: #666;
		margin-bottom: 10rpx;
		display: flex;
		align-items: center;
}
.highlight-label .iconfont.data-v-7170c164 {
		color: #FF7D00;
		font-size: 26rpx;
		margin-right: 10rpx;
}

	/* 收益数值 - 极致醒目 */
.highlight-value.data-v-7170c164 {
		font-size: 48rpx;
		font-weight: 800;
		color: #E86800;
		text-shadow: 0 0 10rpx rgba(255, 125, 0, 0.2);
		letter-spacing: 1rpx;
}

	/* 5个小数据网格布局 - 规整排列 */
.summary-grid.data-v-7170c164 {
		display: flex;
		flex-wrap: wrap;
		/* 自动换行，保证排列规则 */
		justify-content: space-between;
		gap: 15rpx 0;
		/* 项之间的上下间距 */
}

	/* 小数据项 - 统一样式，2列/3列自适应 */
.summary-item.data-v-7170c164 {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		/* 每2个占一行，自动均分宽度（5个则2+2+1，视觉更规整） */
		flex: 0 0 48%;
		padding: 15rpx 0;
		border-bottom: 1rpx solid #f8f8f8;
}

	/* 最后一行的项去掉下边框 */
.summary-item.data-v-7170c164:nth-last-child(1),
	.summary-item.data-v-7170c164:nth-last-child(2) {
		border-bottom: none;
}

	/* 小数据标签 */
.summary-label.data-v-7170c164 {
		font-size: 24rpx;
		color: #555;
		margin-bottom: 8rpx;
		display: flex;
		align-items: center;
}
.summary-label .iconfont.data-v-7170c164 {
		color: #FF9500;
		font-size: 22rpx;
		margin-right: 8rpx;
}

	/* 小数据数值 */
.summary-value.data-v-7170c164 {
		font-size: 28rpx;
		font-weight: 700;
		color: #FF7D00;
}
.content-container.data-v-7170c164 {
		width: 92%;
		margin: 0 auto;
		padding-top: 15px;
}
.empty-tip.data-v-7170c164 {
		text-align: center;
		padding: 60px 0;
		color: #999;
		font-size: 14px;
}
.card-list.data-v-7170c164 {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 12px;
		margin-bottom: 15px;
}
.city-card.data-v-7170c164,
	.district-card.data-v-7170c164 {
		background-color: #fff;
		border-radius: 12px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
		padding: 15px;
		transition: transform 0.2s;
}

	/* 
	.city-card:active,
	.district-card:active {
		transform: scale(0.98);
	} */
.card-header.data-v-7170c164 {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10px;
		padding-bottom: 6px;
		border-bottom: 1px solid #f5f5f5;
}
.card-title.data-v-7170c164 {
		font-size: 40rpx;
		font-weight: bold;
		color: #2d3748;
}
.item-label.data-v-7170c164 {
		font-size: 11px;
		color: #718096;
		margin-bottom: 4px;
}
.item-value.data-v-7170c164 {
		font-size: 14px;
		font-weight: 500;
		color: #2d3748;
}
.load-more.data-v-7170c164 {
		text-align: center;
		padding: 15px 0;
		font-size: 13px;
		color: #4285F4;
}

	/* 响应式适配 */
@media (max-width: 767px) {
.summary-card.data-v-7170c164 {
			flex-direction: column;
}
.card-body.data-v-7170c164 {
			grid-template-columns: 1fr 1fr;
}
.card-list.data-v-7170c164 {
			grid-template-columns: 1fr;
}
}
