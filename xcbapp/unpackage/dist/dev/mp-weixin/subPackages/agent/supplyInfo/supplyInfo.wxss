
	/* 基础布局 */
.supply-demand-page.data-v-cc371561 {
		background-color: #f2f2f2;
		min-height: 100vh;
		font-size: 14px;
		padding-bottom: 40px;
}

	/* 头部：带筛选按钮 */
.page-header.data-v-cc371561 {
		padding: 20px 16px;
		background: linear-gradient(135deg, #FFF8F0 0%, #FFE8D0 100%);
		display: flex;
		align-items: center;
		justify-content: space-between;
		box-shadow: 0 2rpx 15rpx rgba(255, 125, 0, 0.1);
}
.back-btn.data-v-cc371561 {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: 15px;
		color: #FF7D00;
}
.header-title.data-v-cc371561 {
		font-size: 18px;
		font-weight: 600;
		color: #333;
}
.header-filter.data-v-cc371561 {
		width: 40rpx;
		height: 40rpx;
		border-radius: 50%;
		background: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
}

	/* 统计卡片：带装饰和子标题 */
.summary-card.data-v-cc371561 {
		position: relative;
		background-color: #ffffff;
		border-radius: 16rpx;
		box-shadow: 0 4rpx 20rpx rgba(255, 125, 0, 0.08);
		padding: 30rpx 20rpx;
		margin: 20rpx 15rpx;
		border: 1rpx solid #FFE8D0;
		overflow: hidden;
}
.summary-bg-icon.data-v-cc371561 {
		position: absolute;
		top: 10rpx;
		right: 20rpx;
		font-size: 60rpx;
		color: rgba(255, 125, 0, 0.08);
}
.summary-item.single-item.data-v-cc371561 {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 10rpx 0;
}
.summary-label.data-v-cc371561 {
		font-size: 26rpx;
		color: #666;
		margin-bottom: 5rpx;
}
.summary-value.data-v-cc371561 {
		font-size: 40rpx;
		font-weight: 700;
		color: #FF7D00;
		margin-bottom: 5rpx;
}
.summary-sub.data-v-cc371561 {
		font-size: 22rpx;
		color: #999;
}

	/* Tab 切换栏 */
.tab-bar.data-v-cc371561 {
		display: flex;
		background: #fff;
		margin: 0 15rpx 20rpx;
		border-radius: 12rpx;
		overflow: hidden;
		box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.tab-item.data-v-cc371561 {
		flex: 1;
		text-align: center;
		padding: 15rpx 0;
		font-size: 28rpx;
		color: #666;
}
.tab-item.active.data-v-cc371561 {
		background: #FF7D00;
		color: #fff;
}

	/* 内容容器 */
.content-container.data-v-cc371561 {
		width: 92%;
		margin: 0 auto;
}

	/* 空数据美化 */
.empty-tip.data-v-cc371561 {
		text-align: center;
		padding: 80px 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 15px;
}
.empty-icon.data-v-cc371561 {
		font-size: 80rpx;
		color: #ccc;
}
.empty-text.data-v-cc371561 {
		font-size: 26rpx;
		color: #999;
}
.empty-btn.data-v-cc371561 {
		padding: 10rpx 25rpx;
		background: #FFF8F0;
		color: #FF7D00;
		border-radius: 20rpx;
		font-size: 24rpx;
}

	/* 卡片列表 */
.card-list.data-v-cc371561 {
		display: grid;
		grid-template-columns: 1fr;
		gap: 15px;
		margin-bottom: 20px;
}

	/* 供应卡片：左侧图片+内容 */
.supply-card.data-v-cc371561,
	.demand-card.data-v-cc371561 {
		display: flex;
		align-items: center;
		gap: 15px;
		background-color: #fff;
		border-radius: 16rpx;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
		padding: 15px;
		transition: all 0.2s ease;
}
.supply-card.data-v-cc371561:active,
	.demand-card.data-v-cc371561:active {
		transform: scale(0.98);
		box-shadow: 0 1px 6px rgba(0, 0, 0, 0.04);
}

	/* 产品/求购品图片占位 */
.supply-img.data-v-cc371561,
	.demand-img.data-v-cc371561 {
		width: 200rpx;
		height: 200rpx;
		border-radius: 12rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 28rpx;
		color: #666;
		font-weight: 600;
}
.supply-content.data-v-cc371561,
	.demand-content.data-v-cc371561 {
		flex: 1;
}
.content-header.data-v-cc371561 {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
}
.supply-name.data-v-cc371561,
	.demand-name.data-v-cc371561 {
		font-size: 16px;
		font-weight: 600;
		color: #333;
}

	/* 状态标签 */
.supply-tag.data-v-cc371561,
	.demand-tag.data-v-cc371561 {
		padding: 2px 8px;
		border-radius: 10px;
		font-size: 12px;
}
.supply-tag.on.data-v-cc371561 {
		background: #ECFDF3;
		color: #00B42A;
}
.supply-tag.off.data-v-cc371561 {
		background: #F5F5F5;
		color: #999;
}
.demand-tag.pending.data-v-cc371561 {
		background: #FFF1F0;
		color: #FF7D00;
}
.demand-tag.done.data-v-cc371561 {
		background: #F5F5F5;
		color: #999;
}
.content-body.data-v-cc371561 {
		display: flex;
		flex-direction: column;
		gap: 8px;
}
.body-row.data-v-cc371561 {
		display: flex;
		gap: 15px;
}
.row-item.full.data-v-cc371561 {
		flex: 1;
}
.item-label.data-v-cc371561 {
		font-size: 13px;
		color: #999;
}
.item-value.data-v-cc371561 {
		font-size: 14px;
		color: #333;
}
.item-value.price.data-v-cc371561 {
		color: #FF7D00;
		font-weight: 500;
}
.item-value.low.data-v-cc371561 {
		color: #F53F3F;
}

	/* 加载更多 */
.load-more.data-v-cc371561 {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 15px 0;
		font-size: 14px;
		color: #FF7D00;
		font-weight: 500;
}

	/* 筛选弹窗 */
.filter-popup.data-v-cc371561 {
		background: #fff;
		border-radius: 16rpx 16rpx 0 0;
		padding: 20rpx;
}
.popup-title.data-v-cc371561 {
		font-size: 28rpx;
		font-weight: 600;
		color: #333;
		margin-bottom: 20rpx;
}
.filter-item.data-v-cc371561 {
		display: flex;
		flex-direction: column;
		gap: 10rpx;
		margin-bottom: 20rpx;
}
.filter-item text.data-v-cc371561 {
		font-size: 26rpx;
		color: #333;
}
.filter-options.data-v-cc371561 {
		display: flex;
		gap: 15rpx;
		flex-wrap: wrap;
}
.option.data-v-cc371561 {
		padding: 8rpx 20rpx;
		background: #F5F5F5;
		border-radius: 20rpx;
		font-size: 24rpx;
		color: #666;
}
.option.active.data-v-cc371561 {
		background: #FF7D00;
		color: #fff;
}
.popup-btns.data-v-cc371561 {
		display: flex;
		gap: 15rpx;
		margin-top: 30rpx;
}
.btn.data-v-cc371561 {
		flex: 1;
		text-align: center;
		padding: 15rpx 0;
		border-radius: 8rpx;
		font-size: 26rpx;
}
.btn.cancel.data-v-cc371561 {
		background: #F5F5F5;
		color: #666;
}
.btn.confirm.data-v-cc371561 {
		background: #FF7D00;
		color: #fff;
}
