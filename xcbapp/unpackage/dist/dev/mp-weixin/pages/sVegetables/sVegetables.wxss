  letter-spacing: 6rpx;
}

/* 选项卡片容器（白色大圆角 + 立体阴影，内部列表清晰不混乱） */
.selection-card.data-v-9c8f2f2f {
  width: 100%;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.07);
  overflow: hidden;
  margin-bottom: 70rpx;
}
.option-item.data-v-9c8f2f2f {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  transition: all 0.25s ease;
  border-bottom: 1rpx solid #f5f5f5;
}
.option-item.data-v-9c8f2f2f:last-child {
  border-bottom: none;
}
.option-item.data-v-9c8f2f2f:active {
  background: #f8f9fb;
  transform: scale(0.98);
}
.option-item .icon-box.data-v-9c8f2f2f {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 36rpx;
  flex-shrink: 0;
}
.option-item .option-text.data-v-9c8f2f2f {
  flex: 1;
}
.option-item .option-text .title.data-v-9c8f2f2f {
  font-size: 38rpx;
  font-weight: 700;
  color: #2d3436;
  display: block;
  margin-bottom: 4rpx;
}
.option-item .option-text .desc.data-v-9c8f2f2f {
  font-size: 26rpx;
  color: #8a8f99;
  line-height: 1.4;
}

