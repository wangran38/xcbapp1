/* 用户信息卡片 */
.user-card.data-v-0f7520f0 {
  background: #fff;
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 36rpx;
}
.user-card .user-info.data-v-0f7520f0 {
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.user-card .user-info .user-img.data-v-0f7520f0 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}
.user-card .user-info .user-img image.data-v-0f7520f0 {
  width: 100%;
  height: 100%;
}
